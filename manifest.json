{
  "manifest_version": 3,
  "name": "Net Meter Plus",
  "version": "1.1.0",
  "description": "Измерение входящей и исходящей скорости сети, ping, IP и страны через Cloudflare.",
  "action": {
    "default_title": "Net Meter Plus",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://speed.cloudflare.com/*",
    "https://*.cloudflare.com/*"
  ],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "netmeterplus@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
